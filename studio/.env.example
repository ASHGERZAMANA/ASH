SANITY_STUDIO_PROJECT_ID="<paste your project ID here>" # Required - The ID of your Sanity project
SANITY_STUDIO_DATASET="production" # Required - The dataset of your Sanity project
SANITY_STUDIO_PREVIEW_URL="http://localhost:3021" # The site Presentation previews. Use the deployed URL in production.
SANITY_STUDIO_STUDIO_HOST="" # The hosted Studio subdomain: <host>.sanity.studio. Set in .env.production for deploys.