{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "predev": "npm run sanity:typegen",
    "dev": "sanity dev --port 3333",
    "sanity:typegen": "sanity schema extract --enforce-required-fields --force --path ../sanity.schema.json && sanity typegen generate",
    "start": "sanity start",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/assist": "^6.2.6",
    "@sanity/color-input": "^6.1.9",
    "@sanity/icons": "^3.8.0",
    "@sanity/orderable-document-list": "2.0.28",
    "@sanity/vision": "^6.22.0",
    "date-fns": "^4.1.0",
    "pluralize-esm": "^9.0.5",
    "react": "^19.2.5",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "sanity": "^6.13.1",
    "sanity-plugin-asset-source-unsplash": "^7.0.30",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
